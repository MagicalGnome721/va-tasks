    r.push(sz === 'S' ? 'Việc nhỏ (S)' : sz === 'M' ? 'Việc vừa (M)' : sz === 'L' ? 'Việc lớn (L)' : sz === 'XL' ? 'Việc rất lớn (XL) — cần chia đợt' : 'Chưa chấm độ nặng');
